@model IEnumerable<WAmvc1.Models.DrAccount>

@{
    ViewData["PageTitle"] = "Accounts";
    ViewData["PageActionText"] = "+New Account";
    ViewData["PageActionUrl"] = "/DrAccount/AddOrEdit";
}

<div class="row">
    <div class="col-md-7">
        <ejs-grid id="draccounts" dataSource="@Model"
        allowSorting="true" allowPaging="true">
        <e-grid-pagesettings pageSize="5"></e-grid-pagesettings>    
            <e-grid-columns>
                <e-grid-column headerText="Account" field="Title"> </e-grid-column>
                <e-grid-column headerText="RevExpAccount" template="#typeColumnTemplate" width="150"> </e-grid-column>
                <e-grid-column headerText="Actions" template="#actionColumnTemplate" width="100"> </e-grid-column>
            </e-grid-columns>

        </ejs-grid>
    </div>

</div>

<script id="typeColumnTemplate" type="text/x-template">
    ${if(RevExpAccount=="Revenue")}
    <span class="badge bg-success">${RevExpAccount}</span>
    ${/if}
    ${if(RevExpAccount=="Expense")}
    <span class="badge bg-danger">${RevExpAccount}</span>
    ${/if}
    ${if(RevExpAccount=="No")}
    <span class="badge bg-black">${RevExpAccount}</span>
    ${/if}


</script>

<script id="actionColumnTemplate" type="text/x-template">
    <div class="d-flex flex-row justify-content-start">
        <a class="btn btn-sm no-a-decoration" href="/DrAccount/AddOrEdit/${DrAccountId}">
            <i class="fa-solid fa-pen fa-lg"></i>
        </a>
        <form action="/DrAccount/Delete/${DrAccountId}" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-link no-a-decoration"
            onclick="return confirm(&quot;Are sure to delete this record?&quot;)">
                
                <i class="fa-solid fa-trash-can fa-lg text-danger"></i>
             </button>
        </form>
    </div>
</script>


