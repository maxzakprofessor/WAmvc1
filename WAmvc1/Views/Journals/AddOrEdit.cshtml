@model WAmvc1.Models.Journal
@{
    ViewData["PageTitle"] = Model.JournalId == 0 ? "Create a new Journal" : "Edit Journal";
}

<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.2.1.min.js"></script>


<div class="row">
    <div class="col-md-7">
        <div class="widget p-5" style="background-color:#212b36">
            <form asp-action="AddOrEdit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" name="JournalId" value="@Model.JournalId" />
                <div class="mb-3">
                    <ejs-datepicker id="date" ejs-for="Date"
                                    placeholder="Date" floatLabelType="Always"
                                    format="dd-MMM-yy">
                    </ejs-datepicker>

                </div>
    
                <div class="mb-3">
                    <ejs-dropdownlist id="draccountid" ejs-for="DrAccountId"
                                      dataSource="@ViewBag.DrAccounts" 
                                      placeholder="DrAccount" floatLabelType="Always" allowFiltering="true" ignoreAccent="true"
                                      filterType="Contains" popupHeight="220px" change="DrAmountEnabled">
                        <e-dropdownlist-fields value="DrAccountId" text="Title"></e-dropdownlist-fields>
                    </ejs-dropdownlist>
                </div>
                <div class="mb-3">
                    <ejs-dropdownlist id="craccountid" ejs-for="CrAccountId" 
                                      dataSource="@ViewBag.CrAccounts" 
                                      placeholder="CrAccount" floatLabelType="Always" allowFiltering="true" ignoreAccent="true"
                                      filterType="Contains" popupHeight="220px" change="CrAmountEnabled">
                        <e-dropdownlist-fields value="CrAccountId" text="Title"></e-dropdownlist-fields>
                    </ejs-dropdownlist>
                </div>
                <div class="mb-3">
                    <ejs-numerictextbox id="dramount_" ejs-for="DrAmmount"
                                        placeholder="DrAmmount" floatLabelType="Always"
                                        min="0" format="c0" change="DrCrAmount"></ejs-numerictextbox>
                    <span asp-validation-for="DrAmmount" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <ejs-numerictextbox id="cramount_" ejs-for="CrAmmount" 
                                        placeholder="CrAmmount" floatLabelType="Always"
                                        min="0" format="c0" ></ejs-numerictextbox>
                    <span asp-validation-for="CrAmmount" class="text-danger"></span>
                </div>
                <div class="mb-3">

                    <ejs-textbox id="note" placeholder="Note" ejs-for="Note" floatLabelType="Always"
                                 multiline="true"></ejs-textbox>
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
                <ejs-button id="submit" content="Submit" cssClass="e-success" created="ButtonSubmitActions"></ejs-button>
            </form>
        </div>

    </div>

</div>


@section Scripts {
    <script>
        function DrCrAmount() {
            var DrAmount_ = document.getElementById("dramount_");
            var CrAmount_ = document.getElementById("cramount_");
            if (CrAmount_.ej2_instances[0].enabled == true && DrAmount_.ej2_instances[0].value != 0)
                CrAmount_.ej2_instances[0].value = DrAmount_.ej2_instances[0].value;
        }
    </script>
    <script>
        function CrAmountEnabled() {
            var CrAmount_ = document.getElementById("cramount_");
            var CrAccount_ = document.getElementById("craccountid");
            if (CrAccount_.value == "NotAccount") {
                CrAmount_.ej2_instances[0].enabled = false;
                CrAmount_.ej2_instances[0].value = 0;}
            if (CrAccount_.value != "NotAccount") {
                CrAmount_.ej2_instances[0].enabled = true;
                DrCrAmount();}
        }
    </script>
    <script>
        function DrAmountEnabled() {
            var DrAmount_ = document.getElementById("dramount_");
            var DrAccount_ = document.getElementById("draccountid");
            if (DrAccount_.value == "NotAccount") {
                DrAmount_.ej2_instances[0].enabled = false;
                DrAmount_.ej2_instances[0].value = 0;}

            if (DrAccount_.value != "NotAccount") DrAmount_.ej2_instances[0].enabled = true;
        }
    </script>
    <script>
        function ButtonSubmitActions() {
            CrAmountEnabled();
            DrAmountEnabled();
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }
